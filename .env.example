# Server
PORT=3000
NODE_ENV=development

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string

# Turso database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token
# For local dev with a file-based SQLite:
# TURSO_DATABASE_URL=file:./carton-cache.db
# TURSO_AUTH_TOKEN=

# Web Push (generate with: npm run generate-vapid)
VAPID_EMAIL=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=carton-cache@example.com
