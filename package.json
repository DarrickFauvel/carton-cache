{
  "name": "carton-cache",
  "version": "0.1.0",
  "description": "Shipping carton inventory tracker — new and reused stock",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node esbuild.config.js && cp -r src/views dist/views",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "generate-vapid": "tsx src/scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.2.0",
    "dotenv": "^17.4.1",
    "eta": "^3.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "ulid": "^2.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
