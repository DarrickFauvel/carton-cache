<% layout('/layouts/base') %>

<div class="page-header">
  <h1>Carton Types</h1>
  <% if (it.user && (it.user.role === 'admin' || it.user.role === 'manager')) { %>
  <div class="action-row">
    <a href="/cartons/new" class="btn btn--primary">+ New carton type</a>
  </div>
  <% } %>
</div>

<% if (it.saved) { %>
<p class="alert alert--success" role="status">Saved.</p>
<% } %>
<% if (it.deleteError) { %>
<p class="alert alert--error" role="alert"><%= it.deleteError %></p>
<% } %>

<% if (it.cartons.length === 0) { %>
<div class="empty-state">
  <p>No carton types yet.</p>
  <a href="/cartons/new" class="btn btn--primary">Add your first carton type</a>
</div>
<% } else { %>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>SKU</th>
        <th>Barcode</th>
        <th>Printed (<%= it.unit %>)</th>
        <th>Actual inside (<%= it.unit %>)</th>
        <th>Unit cost</th>
        <th>Label</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% it.cartons.forEach(function(c) { %>
      <tr id="carton-<%= c.id %>">
        <td data-label="Name"><strong><%= c.name %></strong><% if (c.archived_at != null) { %> <small class="badge">Archived</small><% } else if (Number(c.single_use) === 1) { %> <small class="badge">One-time use</small><% } %><% if (c.notes) { %><br><small><%= c.notes %></small><% } %></td>
        <td data-label="SKU"><% if (c.sku) { %><code><%= c.sku %></code><% } else { %>—<% } %></td>
        <td data-label="Barcode"><% if (c.barcode) { %><code><%= c.barcode %></code><% } else { %>—<% } %></td>
        <td data-label="Printed (<%= it.unit %>)">
          <% if (c.printed_length_cm != null && c.printed_width_cm != null && c.printed_height_cm != null) { %>
          <%= it.toUnit(Number(c.printed_length_cm)) %><span class="dim-x">×</span><%= it.toUnit(Number(c.printed_width_cm)) %><span class="dim-x">×</span><%= it.toUnit(Number(c.printed_height_cm)) %>
          <% } else { %>—<% } %>
        </td>
        <td data-label="Actual inside (<%= it.unit %>)">
          <% if (c.length_cm && c.width_cm && c.height_cm) { %>
          <%= it.toUnit(Number(c.length_cm)) %><span class="dim-x">×</span><%= it.toUnit(Number(c.width_cm)) %><span class="dim-x">×</span><%= it.toUnit(Number(c.height_cm)) %>
          <% } else { %>—<% } %>
        </td>
        <td data-label="Unit cost"><%= c.unit_cost != null ? '$' + Number(c.unit_cost).toFixed(2) : '—' %></td>
        <td data-label="Label">
          <% if (c.label_code) { %>
          <code><%= c.label_code %></code>
          <% } else { %>—<% } %>
        </td>
        <td class="table-cell--actions">
          <div class="action-row">
            <% if (c.label_code) { %>
            <a href="/cartons/<%= c.id %>/label" target="_blank" class="btn btn-ghost" aria-label="Print label for <%= c.name %>">Print</a>
            <% } %>
            <% if (it.user && (it.user.role === 'admin' || it.user.role === 'manager')) { %>
            <a href="/cartons/<%= c.id %>/edit" class="btn btn-ghost">Edit</a>
            <% if (c.archived_at != null) { %>
            <form method="post" action="/cartons/<%= c.id %>/unarchive">
              <button type="submit" class="btn btn-ghost">Unarchive</button>
            </form>
            <% } %>
            <form method="post" action="/cartons/<%= c.id %>/delete">
              <button type="submit" class="btn btn--danger"
                      onclick="return confirm('Delete <%= c.name %>? This cannot be undone.')">
                Delete
              </button>
            </form>
            <% } %>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
