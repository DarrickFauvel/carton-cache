<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title><%= it.labelCode %></title>
  <style>
    @page { size: 3.5in 1.125in; margin: 0.05in; }
    body { margin: 0; font-family: monospace; }
    /* Exactly the printable area (page minus @page margins), on screen too, so
       the fit measured on screen matches what prints. */
    .label { box-sizing: border-box; width: 3.4in; height: 1.025in; padding: 0 0.15in; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .code { font-size: 24pt; font-weight: bold; white-space: nowrap; line-height: 1; }
    .actions { position: fixed; bottom: 0.1in; }
    @media print { .actions { display: none; } }
  </style>
</head>
<body>
  <div class="label"><span class="code"><%= it.labelCode %></span></div>
  <div class="actions">
    <button type="button" onclick="window.print()">Print</button>
    <a href="/cartons">Back</a>
  </div>
  <script>
    // Largest size the code is printed at; long codes shrink below this to fit.
    const MAX_PT = 24;

    // Print the code at MAX_PT, or smaller if that wouldn't fit the label's
    // width (or height). Text width grows linearly with font size, so one
    // measurement is enough.
    function fitCode() {
      const label = document.querySelector(".label");
      const code = document.querySelector(".code");
      const base = 100;
      code.style.fontSize = base + "px";
      const style = getComputedStyle(label);
      const width = label.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
      const scale = Math.min(width / code.offsetWidth, label.clientHeight / code.offsetHeight);
      const fitPx = Math.floor(base * scale * 0.95);
      const maxPx = MAX_PT * 96 / 72;
      code.style.fontSize = Math.min(fitPx, maxPx) + "px";
    }
    window.onload = () => {
      fitCode();
      window.print();
    };
  </script>
</body>
</html>
