<% layout('/layouts/base') %>

<h1 class="sr-only">Dashboard</h1>
<nav class="quick-actions" aria-label="Quick actions">
  <a href="/transactions/receive" class="quick-action quick-action--in">
    <svg class="quick-action__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3v14m0 0l-5-5m5 5l5-5"/>
      <path d="M3 18h18" stroke-width="2"/>
    </svg>
    <strong class="quick-action__verb">Receive</strong>
    <span class="quick-action__hint">Scan cartons in</span>
  </a>
  <a href="/transactions/consume" class="quick-action quick-action--out">
    <svg class="quick-action__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 21V7m0 0l-5 5m5-5l5 5"/>
      <path d="M3 6h18" stroke-width="2"/>
    </svg>
    <strong class="quick-action__verb">Consume</strong>
    <span class="quick-action__hint">Scan cartons out</span>
  </a>
</nav>

<% const conditionLabel = { new: 'New', good: 'Good', fair: 'Fair', poor: 'Poor', any: 'Any condition' }; %>

<% if (it.locations.length === 0) { %>
<div class="empty-state">
  <p>No stock recorded yet.</p>
  <a href="/transactions/receive" class="btn btn--primary">Receive your first cartons</a>
</div>
<% } %>

<% if (it.lowStock.length > 0) { %>
<section class="low-stock" aria-labelledby="low-stock-heading">
  <h2 id="low-stock-heading" class="low-stock__title">Low stock <span class="low-stock__count"><%= it.lowStock.length %></span></h2>
  <ul class="low-stock__list">
    <% it.lowStock.forEach(function(a) { %>
    <li>
      <a href="#<%= a.rowId %>">
        <span class="low-stock__name"><%= a.name %></span>
        <span class="low-stock__where"><%= a.location_name %> · <%= conditionLabel[a.condition] %></span>
        <span class="low-stock__qty"><%= a.quantity %> <small>/ min <%= a.min_quantity %></small></span>
      </a>
    </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (it.locations.length > 0) { %>
<div class="inventory-header">
  <h2 class="inventory-heading">Inventory</h2>
  <nav class="sort-toggle" aria-label="Sort by size">
    <a href="/?sort=asc" <%~ it.sort === 'asc' ? 'aria-current="true"' : '' %>>Smallest first</a>
    <a href="/?sort=desc" <%~ it.sort === 'desc' ? 'aria-current="true"' : '' %>>Largest first</a>
  </nav>
</div>
<% } %>

<% it.locations.forEach(function(loc) { %>
<section class="location-block<%= loc.sub ? ' location-block--sub' : '' %>">
  <h2 class="location-title"><%= loc.name %></h2>
  <ul class="stock-list">
    <% loc.rows.forEach(function(row) { %>
    <li class="stock-row<%= row.low ? ' stock-row--low' : '' %>" id="<%= row.id %>">
      <% const hasDims = row.length_cm != null && row.width_cm != null && row.height_cm != null; %>
      <div class="stock-row__main">
        <% if (row.label_code) { %>
        <span class="stock-row__lead stock-row__label"><%= row.label_code %><a href="/cartons/<%= row.carton_type_id %>/label" target="_blank" class="stock-row__print" aria-label="Print label <%= row.label_code %>" title="Print label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9V3h12v6"/>
            <rect x="3" y="9" width="18" height="8" rx="2"/>
            <path d="M6 14h12v7H6z"/>
          </svg>
        </a></span>
        <% } else if (hasDims) { %>
        <span class="stock-row__lead"><%= it.toUnit(row.length_cm) %><span class="dim-x">×</span><%= it.toUnit(row.width_cm) %><span class="dim-x">×</span><%= it.toUnit(row.height_cm) %> <small><%= it.unit %></small></span>
        <% } else { %>
        <span class="stock-row__lead stock-row__lead--none">No size</span>
        <% } %>
        <span class="stock-row__name"><%= row.name %><% if (row.low) { %> <small class="stock-row__flag">Low</small><% } %></span>
      </div>
      <div class="stock-row__conditions">
        <% row.conditions.forEach(function(c) { %>
        <span class="stock-chip condition--<%= c.condition %>"><%= conditionLabel[c.condition] %> <strong><%= c.quantity %></strong></span>
        <% }) %>
        <% if (row.total === 0) { %><span class="stock-row__out">Out of stock</span><% } %>
      </div>
      <div class="stock-row__total" aria-label="<%= row.total %> in stock"><%= row.total %></div>
    </li>
    <% }) %>
  </ul>
</section>
<% }) %>
