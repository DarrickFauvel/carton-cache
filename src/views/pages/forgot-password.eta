<% layout('/layouts/base') %>

<section class="auth-card">
  <h1>Reset password</h1>

  <% if (it.sent) { %>
  <p class="alert alert--warning">
    If that email is registered, a reset link is on its way. Check your inbox (and spam folder).
  </p>
  <p class="auth-sub"><a href="/login">Back to sign in</a></p>
  <% } else { %>

  <p class="auth-sub">Enter your email and we'll send you a reset link.</p>

  <% if (it.error) { %>
  <p class="alert alert--error" role="alert"><%= it.error %></p>
  <% } %>

  <form method="post" action="/forgot-password" class="stack">
    <div class="form-group">
      <label for="email">Email</label>
      <input id="email" type="email" name="email" autocomplete="email"
             inputmode="email" required autofocus />
    </div>

    <button type="submit" class="btn btn--primary">Send reset link</button>
  </form>

  <p class="auth-sub auth-switch"><a href="/login">Back to sign in</a></p>
  <% } %>
</section>
