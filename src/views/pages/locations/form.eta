<% layout('/layouts/base') %>

<div class="page-header">
  <h1><%= it.title %></h1>
  <div class="action-row">
    <a href="/locations" class="btn">Cancel</a>
  </div>
</div>

<% if (it.error) { %>
<p class="alert alert--error" role="alert"><%= it.error %></p>
<% } %>

<section class="form-card">
  <form method="post" action="<%= it.location ? '/locations/' + it.location.id + '/edit' : '/locations' %>" class="stack">

    <div class="form-group">
      <label for="name">Name</label>
      <input id="name" type="text" name="name"
             value="<%= it.location ? it.location.name : '' %>" required autofocus />
    </div>

    <div class="form-group">
      <label for="parent_id">Located in <small>(optional)</small></label>
      <% const parentId = it.location && it.location.parent_id ? String(it.location.parent_id) : ''; %>
      <select id="parent_id" name="parent_id"<%= it.hasChildren ? ' disabled' : '' %>>
        <option value="">Nowhere — it's a top-level location</option>
        <% it.parents.forEach(function(p) { %>
        <option value="<%= p.id %>"<%= parentId === p.id ? ' selected' : '' %>><%= p.name %><%= p.active ? '' : ' (inactive)' %></option>
        <% }) %>
      </select>
      <% if (it.hasChildren) { %>
      <small>This location has its own sublocations, so it stays top-level.</small>
      <% } else { %>
      <small>Put a stack, shelf or bin inside a location, e.g. a stack on the office shelf. Its stock moves with it.</small>
      <% } %>
    </div>

    <div class="form-group">
      <label for="address">Address <small>(optional)</small></label>
      <input id="address" type="text" name="address"
             value="<%= it.location ? (it.location.address || '') : '' %>" />
    </div>

    <% if (it.location) { %>
    <div class="form-group">
      <label for="active">Status</label>
      <select id="active" name="active">
        <option value="1"<%= it.location.active ? ' selected' : '' %>>Active</option>
        <option value="0"<%= !it.location.active ? ' selected' : '' %>>Inactive</option>
      </select>
    </div>
    <% } %>

    <button type="submit" class="btn btn--primary">
      <%= it.location ? 'Save changes' : 'Create location' %>
    </button>
  </form>
</section>
