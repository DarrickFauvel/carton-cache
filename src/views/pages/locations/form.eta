<% layout('/layouts/base') %>

<div class="page-header">
  <h1><%= it.title %></h1>
  <div class="action-row">
    <a href="/locations" class="btn">Cancel</a>
  </div>
</div>

<section class="form-card">
  <form method="post" action="<%= it.location ? '/locations/' + it.location.id : '/locations' %>" class="stack">

    <div class="form-group">
      <label for="name">Name</label>
      <input id="name" type="text" name="name" value="<%= it.location ? it.location.name : '' %>" required autofocus />
    </div>

    <div class="form-group">
      <label for="address">Address <small>(optional)</small></label>
      <input id="address" type="text" name="address" value="<%= it.location ? (it.location.address || '') : '' %>" />
    </div>

    <% if (it.location) { %>
    <div class="form-group">
      <label for="active">Status</label>
      <select id="active" name="active">
        <option value="1"<%= it.location.active ? ' selected' : '' %>>Active</option>
        <option value="0"<%= !it.location.active ? ' selected' : '' %>>Inactive</option>
      </select>
    </div>
    <% } %>

    <button type="submit" class="btn btn--primary"><%= it.location ? 'Save changes' : 'Create location' %></button>
  </form>
</section>
