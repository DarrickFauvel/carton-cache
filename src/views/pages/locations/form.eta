<% layout('/layouts/base') %>

<div class="page-header">
  <h1><%= it.title %></h1>
  <div class="action-row">
    <a href="/locations" class="btn">Cancel</a>
  </div>
</div>

<% if (it.error) { %>
<p class="alert alert--error" role="alert"><%= it.error %></p>
<% } %>

<section class="form-card">
  <%
    /* Editing only when the location has an id: a new one can still arrive
       with values, e.g. a preselected parent or a re-render after an error. */
    const loc = it.location || {};
    const editing = !!loc.id;
  %>
  <form method="post" action="<%= editing ? '/locations/' + loc.id + '/edit' : '/locations' %>" class="stack">

    <div class="form-group">
      <label for="name">Name</label>
      <input id="name" type="text" name="name"
             value="<%= loc.name || '' %>" required autofocus />
    </div>

    <div class="form-group">
      <label for="parent_id">Located in <small>(optional)</small></label>
      <% const parentId = loc.parent_id ? String(loc.parent_id) : ''; %>
      <select id="parent_id" name="parent_id"<%= it.hasChildren ? ' disabled' : '' %>>
        <option value="">Nowhere — it's a top-level location</option>
        <% it.parents.forEach(function(p) { %>
        <option value="<%= p.id %>"<%= parentId === p.id ? ' selected' : '' %>><%= p.name %><%= p.active ? '' : ' (inactive)' %></option>
        <% }) %>
      </select>
      <% if (it.hasChildren) { %>
      <small>This location has its own sublocations, so it stays top-level.</small>
      <% } else { %>
      <small>Put a stack, shelf or bin inside a location, e.g. a stack on the office shelf. Its stock moves with it.</small>
      <% } %>
    </div>

    <div class="form-group">
      <label for="address">Address <small>(optional)</small></label>
      <input id="address" type="text" name="address"
             value="<%= loc.address || '' %>" />
    </div>

    <% if (editing) { %>
    <div class="form-group">
      <label for="active">Status</label>
      <select id="active" name="active">
        <option value="1"<%= Number(loc.active) ? ' selected' : '' %>>Active</option>
        <option value="0"<%= !Number(loc.active) ? ' selected' : '' %>>Inactive</option>
      </select>
    </div>
    <% } %>

    <button type="submit" class="btn btn--primary">
      <%= editing ? 'Save changes' : 'Create location' %>
    </button>
  </form>
</section>
