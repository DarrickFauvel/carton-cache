<% layout('/layouts/base') %>

<div class="page-header">
  <h1>Settings</h1>
</div>

<% if (it.saved) { %>
<p class="alert alert--success" role="status">Changes saved.</p>
<% } %>
<% if (it.error) { %>
<p class="alert alert--error" role="alert"><%= it.error %></p>
<% } %>

<section class="form-card">
  <form method="post" action="/settings" class="stack">
    <div class="form-group">
      <label for="default_tax_percent">Default tax % <small>(optional)</small></label>
      <input id="default_tax_percent" type="number" name="default_tax_percent" inputmode="decimal" min="0" step="0.01"
             value="<%= it.defaultTaxPercent != null ? it.defaultTaxPercent : '' %>" placeholder="e.g. 8.25" />
      <small>Used to prefill the tax rate on new retail carton options. Each entry can still override it.</small>
    </div>

    <button type="submit" class="btn btn--primary">Save changes</button>
  </form>
</section>
