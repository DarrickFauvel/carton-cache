<% layout('/layouts/base') %>

<div class="page-header">
  <h1>Consume Stock</h1>
</div>

<% if (it.error) { %>
<p class="alert alert--error" role="alert"><%= it.error %></p>
<% } %>

<section class="form-card">
  <details>
    <summary>Not sure which carton? Suggest a size</summary>
    <carton-suggest
      endpoint="/cartons/suggest"
      target="carton_type_id"
      location-target="location_id"
      unit="<%= it.unit %>">
    </carton-suggest>
  </details>
</section>

<section class="form-card">
  <form method="post" action="/transactions/consume" class="stack">

    <div class="form-group">
      <label for="location_id">Take from</label>
      <select id="location_id" name="location_id" required>
        <option value=""><%= it.locations.length ? 'Select location…' : 'No locations have stock' %></option>
        <% it.locations.forEach(function(loc) { %>
        <option value="<%= loc.id %>" <%= it.values.location_id === loc.id ? 'selected' : '' %>><%= loc.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="carton_type_id">Carton type</label>
      <div class="input-row">
        <select id="carton_type_id" name="carton_type_id" required>
          <option value="">Select or scan carton…</option>
          <% it.cartons.forEach(function(c) { %>
          <option value="<%= c.id %>" data-stock="<%= c.stock || '' %>" <%= it.values.carton_type_id === c.id ? 'selected' : '' %>><%= it.cartonLabel(c) %></option>
          <% }) %>
        </select>
        <carton-scanner
          lookup="/cartons/lookup"
          target="carton_type_id"
          quantity-target="quantity"
          notes-target="notes">
          <barcode-scanner>
            <button type="button" class="btn btn--scan" aria-label="Scan carton barcode">Scan</button>
          </barcode-scanner>
        </carton-scanner>
      </div>
      <location-stock-filter location="location_id" target="carton_type_id" condition-choice="condition" quantity="quantity"></location-stock-filter>
    </div>

    <div class="form-group">
      <label for="condition">Condition</label>
      <select id="condition" name="condition" required>
        <% const conditions = [["new", "New"], ["good", "Good"], ["fair", "Fair"], ["poor", "Poor"]]; %>
        <% conditions.forEach(function([value, label]) { %>
        <option value="<%= value %>" <%= it.values.condition === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity</label>
      <qty-stepper class="input-row">
        <button type="button" class="qty-stepper__btn" data-step="-1" aria-label="Decrease quantity by 1">−</button>
        <input id="quantity" type="number" name="quantity" inputmode="numeric" min="1" value="<%= it.values.quantity %>" required />
        <button type="button" class="qty-stepper__btn" data-step="1" aria-label="Increase quantity by 1">+</button>
        <button type="button" class="qty-stepper__btn" data-step="10" aria-label="Increase quantity by 10">+10</button>
      </qty-stepper>
      <small id="quantity_available" hidden></small>
    </div>

    <div class="form-group">
      <label for="notes">Notes <small>(optional)</small></label>
      <textarea id="notes" name="notes" rows="2"><%= it.values.notes %></textarea>
    </div>

    <button type="submit" class="btn btn--primary">Consume cartons</button>
  </form>
</section>
