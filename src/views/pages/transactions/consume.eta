<% layout('/layouts/base') %>

<div class="page-header">
  <h1>Consume Stock</h1>
</div>

<section class="form-card">
  <form method="post" action="/transactions/consume" class="stack">

    <% if (it.locations.length !== 1) { %>
    <div class="form-group">
      <label for="location_id">Location</label>
      <select id="location_id" name="location_id" required>
        <option value="">Select location…</option>
        <% it.locations.forEach(function(loc) { %>
        <option value="<%= loc.id %>"><%= loc.name %></option>
        <% }) %>
      </select>
    </div>
    <% } else { %>
    <input type="hidden" name="location_id" value="<%= it.locations[0].id %>" />
    <% } %>

    <div class="form-group">
      <label for="carton_type_id">Carton type</label>
      <select id="carton_type_id" name="carton_type_id" required>
        <option value="">Select carton…</option>
        <% it.cartons.forEach(function(c) { %>
        <option value="<%= c.id %>"><%= c.name %><% if (c.sku) { %> — <%= c.sku %><% } %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="condition">Condition</label>
      <select id="condition" name="condition" required>
        <option value="new">New</option>
        <option value="good" selected>Good</option>
        <option value="fair">Fair</option>
        <option value="poor">Poor</option>
      </select>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity</label>
      <input id="quantity" type="number" name="quantity" inputmode="numeric" min="1" value="1" required />
    </div>

    <div class="form-group">
      <label for="notes">Notes <small>(optional)</small></label>
      <textarea id="notes" name="notes" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn--primary">Consume cartons</button>
  </form>
</section>
