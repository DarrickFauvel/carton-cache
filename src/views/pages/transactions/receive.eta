<% layout('/layouts/base') %>

<div class="page-header">
  <h1>Receive Stock</h1>
</div>

<% if (it.printLabelCarton) { %>
  <% if (it.printLabelCarton.labelCode) { %>
  <p class="alert alert--success" role="status">
    Received <%= it.printLabelCarton.name %>.
    <a href="/cartons/<%= it.printLabelCarton.id %>/label" target="_blank" class="btn btn--primary">Print label (<%= it.printLabelCarton.labelCode %>)</a>
  </p>
  <% } else { %>
  <p class="alert alert--warning" role="status">
    Received <%= it.printLabelCarton.name %>.
    <a href="/cartons/<%= it.printLabelCarton.id %>/edit">Set a source &amp; size code</a> on this carton type to enable label printing.
  </p>
  <% } %>
<% } %>

<section class="form-card">
  <form method="post" action="/transactions/receive" class="stack">

    <% if (it.locations.length !== 1) { %>
    <div class="form-group">
      <div class="label-row">
        <label for="location_id">Location</label>
        <% if (it.canCreateLocation) { %>
        <quick-create api="/locations" target="location_id" label="New Location">
          <button type="button" class="btn btn-ghost" aria-label="New location">+ Location</button>
          <template>
            <div class="form-group">
              <label>Name</label>
              <input name="name" type="text" required />
            </div>
            <div class="form-group">
              <label>Address <small>(optional)</small></label>
              <input name="address" type="text" />
            </div>
          </template>
        </quick-create>
        <% } %>
      </div>
      <select id="location_id" name="location_id" required>
        <option value="">Select location…</option>
        <% it.locations.forEach(function(loc) { %>
        <option value="<%= loc.id %>"><%= loc.name %></option>
        <% }) %>
      </select>
    </div>
    <% } else { %>
    <input type="hidden" name="location_id" value="<%= it.locations[0].id %>" />
    <% } %>

    <div class="form-group">
      <div class="label-row">
        <label for="carton_type_id">Carton type</label>
        <% if (it.canCreateCarton) { %>
        <quick-create api="/cartons" target="carton_type_id" label="New Carton Type">
          <button type="button" class="btn btn-ghost" aria-label="New carton type">+ Carton type</button>
          <template>
            <div class="form-group">
              <label>Name</label>
              <input name="name" type="text" required />
            </div>
            <div class="form-group">
              <label>Barcode <small>(optional)</small></label>
              <input name="barcode" type="text" inputmode="numeric" autocomplete="off" />
              <small class="field-hint" data-prefill="_barcode_hint" hidden></small>
            </div>
            <div class="form-group">
              <label>SKU <small>(optional)</small></label>
              <input name="sku" type="text" />
            </div>
            <div class="form-group">
              <label>Unit cost <small>(optional)</small></label>
              <input name="unit_cost" type="number" inputmode="decimal" min="0" step="0.01" />
            </div>
            <fieldset class="form-group">
              <legend>Dimensions (cm) <small>(optional)</small></legend>
              <div class="dims-row">
                <div class="form-group">
                  <label>L</label>
                  <input name="length_cm" type="number" inputmode="decimal" min="0" step="0.1" placeholder="—" />
                </div>
                <div class="form-group">
                  <label>W</label>
                  <input name="width_cm" type="number" inputmode="decimal" min="0" step="0.1" placeholder="—" />
                </div>
                <div class="form-group">
                  <label>H</label>
                  <input name="height_cm" type="number" inputmode="decimal" min="0" step="0.1" placeholder="—" />
                </div>
              </div>
            </fieldset>
            <div class="form-group">
              <label>Notes <small>(optional)</small></label>
              <textarea name="notes" rows="2"></textarea>
            </div>
            <details class="scan-raw">
              <summary>Raw scan data</summary>
              <input name="_scanned" type="text" readonly class="scan-raw__value" />
            </details>
          </template>
        </quick-create>
        <% } %>
      </div>
      <div class="input-row">
        <select id="carton_type_id" name="carton_type_id" required>
          <option value="">Select or scan carton…</option>
          <% it.cartons.forEach(function(c) { %>
          <option value="<%= c.id %>"><%= c.name %><% if (c.sku) { %> — <%= c.sku %><% } %></option>
          <% }) %>
        </select>
        <carton-scanner
          lookup="/cartons/lookup"
          target="carton_type_id"
          quantity-target="quantity"
          notes-target="notes"
          <% if (it.canCreateCarton) { %>create="quick-create[target='carton_type_id']"<% } %>>
          <barcode-scanner>
            <button type="button" class="btn btn--scan" aria-label="Scan carton barcode">Scan</button>
          </barcode-scanner>
        </carton-scanner>
      </div>
    </div>

    <div class="form-group">
      <label for="condition">Condition</label>
      <select id="condition" name="condition" required>
        <option value="new" selected>New</option>
        <option value="good">Good</option>
        <option value="fair">Fair</option>
        <option value="poor">Poor</option>
      </select>
    </div>

    <div class="form-group">
      <label for="quantity">Quantity</label>
      <input id="quantity" type="number" name="quantity" inputmode="numeric" min="1" value="1" required />
    </div>

    <div class="form-group">
      <label for="unit_cost">Unit cost override <small>(optional)</small></label>
      <input id="unit_cost" type="number" name="unit_cost" inputmode="decimal" min="0" step="0.01" placeholder="Leave blank to use default" />
    </div>

    <div class="form-group">
      <label for="notes">Notes <small>(optional)</small></label>
      <textarea id="notes" name="notes" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn--primary">Receive cartons</button>
  </form>
</section>
