<% layout('/layouts/base') %>

<div class="welcome">
  <section class="welcome__hero">
    <p class="welcome__eyebrow">Warehouse inventory tool</p>

    <div class="welcome__brand">
      <svg class="welcome__icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <!-- Left face -->
        <path d="M6 20 L24 30 L24 44 L6 34 Z"
              fill="var(--color-primary)" fill-opacity="0.14"
              stroke="var(--color-primary)" stroke-width="2" stroke-linejoin="round"/>
        <!-- Right face (shadowed) -->
        <path d="M24 30 L42 20 L42 34 L24 44 Z"
              fill="var(--color-primary)" fill-opacity="0.24"
              stroke="var(--color-primary)" stroke-width="2" stroke-linejoin="round"/>
        <!-- Top face -->
        <path d="M6 20 L24 10 L42 20 L24 30 Z"
              fill="var(--color-primary)" fill-opacity="0.07"
              stroke="var(--color-primary)" stroke-width="2" stroke-linejoin="round"/>
        <!-- Flap seam -->
        <line x1="24" y1="10" x2="24" y2="30"
              stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.45"/>
      </svg>
      <h1 class="welcome__title">Carton Cache</h1>
    </div>

    <p class="welcome__tagline">
      Track, receive, and consume reusable shipping cartons —<br>
      across every location, from any device.
    </p>

    <div class="welcome__actions">
      <a href="/register" class="btn btn--primary welcome__cta">Sign up free</a>
      <a href="/login" class="btn welcome__cta">Sign in</a>
    </div>
  </section>

  <section class="welcome__features" aria-label="Key features">
    <article class="welcome__feature">
      <div class="welcome__feature-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/>
          <path d="M16.5 9.4 7.55 4.24M3.29 7 12 12l8.71-5M12 22V12"/>
          <circle cx="18.5" cy="15.5" r="2.5"/><path d="M20.27 17.27 22 19"/>
        </svg>
      </div>
      <h3>Multi-location tracking</h3>
      <p>Monitor stock levels across all your warehouses and storage sites in one view.</p>
    </article>

    <article class="welcome__feature">
      <div class="welcome__feature-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 5h3M3 9h3M3 13h3M3 17h3M3 21h3"/>
          <path d="M9 5h3M9 9h3M9 13h3M9 17h3M9 21h3"/>
          <rect x="15" y="4" width="7" height="7" rx="1"/>
          <rect x="15" y="14" width="7" height="7" rx="1"/>
        </svg>
      </div>
      <h3>Barcode scanning</h3>
      <p>Receive and consume stock fast — scan carton barcodes straight from your phone camera.</p>
    </article>

    <article class="welcome__feature">
      <div class="welcome__feature-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 20V10M12 20V4M6 20v-6"/>
        </svg>
      </div>
      <h3>Low-stock alerts</h3>
      <p>Set minimum thresholds per location and get notified before you run short.</p>
    </article>
  </section>
</div>
